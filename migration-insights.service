[Unit]
Description=Migration Insights - MongoDB Migration Monitoring Dashboard
After=network.target

[Service]
Type=simple
ExecStart=/opt/migration-insights/migration-insights
WorkingDirectory=/opt/migration-insights
EnvironmentFile=-/etc/migration-insights/env
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/migration-insights

StandardOutput=journal
StandardError=journal
SyslogIdentifier=migration-insights

[Install]
WantedBy=multi-user.target
